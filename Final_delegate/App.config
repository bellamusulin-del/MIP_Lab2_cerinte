<configuration>
	<system.diagnostics>
		<switches>
			<add name="Logare" value="1" />
		</switches>
		<trace autoflush="true">
			<listeners>
				<add name="Fisier"
					 type="System.Diagnostics.TextWriterTraceListener"
					 initializeData="deplasari.txt" />
				<remove name="Default" />
			</listeners>
		</trace>
	</system.diagnostics>
</configuration>
